<?xml version="1.0"?>
<robot name="ackbot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Core sub-components -->
  <xacro:include filename="$(find ackbot_description)/urdf/chassis.xacro"/>
  <xacro:include filename="$(find ackbot_description)/urdf/wheels.xacro"/>
  <xacro:include filename="$(find ackbot_description)/urdf/sensors/camera.xacro"/>
  <xacro:include filename="$(find ackbot_description)/urdf/sensors/lidar.xacro"/>

  <!-- ==================== GAZEBO SIM PLUGINS ==================== -->

  <!-- 1. Ackermann Steering Drive Controller (Gazebo Harmonic) -->
  <gazebo>
    <plugin filename="gz-sim-ackermann-steering-system" name="gz::sim::systems::AckermannSteering">
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <left_steering_joint>front_left_steer_joint</left_steering_joint>
      <right_steering_joint>front_right_steer_joint</right_steering_joint>
      <kingpin_width>0.30</kingpin_width>
      <wheel_base>0.30</wheel_base>
      <wheel_separation>0.30</wheel_separation>
      <wheel_radius>0.06</wheel_radius>
      <min_velocity>-0.40</min_velocity>
      <max_velocity>0.80</max_velocity>
      <min_steering_angle>-0.553953</min_steering_angle>
      <max_steering_angle>0.553953</max_steering_angle>
      <steer_p_gain>50.0</steer_p_gain>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>

    <!-- 2. Joint State Publisher Plugin -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>
  </gazebo>

</robot>
