<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Elevated LiDAR Mount Stalk -->
  <link name="lidar_stalk">
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <!-- 4cm high standoff above Level 3 deck -->
        <cylinder radius="0.015" length="0.04"/>
      </geometry>
      <material name="matte_black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="lidar_stalk_joint" type="fixed">
    <parent link="deck_level_3"/>
    <child link="lidar_stalk"/>
    <!-- Rear axle: X = -0.15m -->
    <origin xyz="-0.15 0 0" rpy="0 0 0"/>
  </joint>

  <!-- LiDAR Sensor Puck Link (Z = 0.30m from ground) -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <!-- 70mm diameter x 40mm height puck -->
        <cylinder radius="0.035" length="0.04"/>
      </geometry>
      <material name="lidar_blue">
        <color rgba="0.1 0.3 0.6 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.17"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="lidar_stalk"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
  </joint>

  <!-- Gazebo Sim 2D LiDAR (360-degree planar scan) -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.10</min>
          <max>3.00</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.005</stddev>
        </noise>
      </ray>
      <always_on>1</always_on>
      <update_rate>20</update_rate>
      <visualize>true</visualize>
      <topic>/scan</topic>
    </sensor>
  </gazebo>

</robot>
