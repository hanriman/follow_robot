<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="follow_clutter">
    <physics name="1ms" type="ignored">
      <max_step_size>0.005</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Lighting -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground Plane (10m x 10m) -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material>
            <ambient>0.15 0.16 0.18 1</ambient>
            <diffuse>0.15 0.16 0.18 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Outer Boundary Walls (10m x 10m enclosure) -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>10.2 0.2 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>10.2 0.2 1.0</size></box></geometry>
          <material><diffuse>0.35 0.38 0.45 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0 -5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>10.2 0.2 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>10.2 0.2 1.0</size></box></geometry>
          <material><diffuse>0.35 0.38 0.45 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>5 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 10.2 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 10.2 1.0</size></box></geometry>
          <material><diffuse>0.35 0.38 0.45 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-5 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 10.2 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 10.2 1.0</size></box></geometry>
          <material><diffuse>0.35 0.38 0.45 1</diffuse></material></visual>
      </link>
    </model>

    <!-- 6 Static Obstacle Pillars matching AckBotFollow-v0 Gymnasium parameters -->
    <model name="pillar_1">
      <static>true</static>
      <pose>1.8 1.8 0.75 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.35</radius><length>1.5</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.35</radius><length>1.5</length></cylinder></geometry>
          <material><diffuse>0.27 0.29 0.34 1</diffuse></material></visual>
      </link>
    </model>
    <model name="pillar_2">
      <static>true</static>
      <pose>-2.0 1.5 0.75 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.40</radius><length>1.5</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.40</radius><length>1.5</length></cylinder></geometry>
          <material><diffuse>0.27 0.29 0.34 1</diffuse></material></visual>
      </link>
    </model>
    <model name="pillar_3">
      <static>true</static>
      <pose>2.0 -2.0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.45</radius><length>1.5</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.45</radius><length>1.5</length></cylinder></geometry>
          <material><diffuse>0.27 0.29 0.34 1</diffuse></material></visual>
      </link>
    </model>
    <model name="pillar_4">
      <static>true</static>
      <pose>-2.2 -1.8 0.75 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.35</radius><length>1.5</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.35</radius><length>1.5</length></cylinder></geometry>
          <material><diffuse>0.27 0.29 0.34 1</diffuse></material></visual>
      </link>
    </model>
    <model name="pillar_5">
      <static>true</static>
      <pose>0.0 3.0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.40</radius><length>1.5</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.40</radius><length>1.5</length></cylinder></geometry>
          <material><diffuse>0.27 0.29 0.34 1</diffuse></material></visual>
      </link>
    </model>
    <model name="pillar_6">
      <static>true</static>
      <pose>0.0 -3.0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.40</radius><length>1.5</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.40</radius><length>1.5</length></cylinder></geometry>
          <material><diffuse>0.27 0.29 0.34 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Primary Human Target Beacon (Amber Torso) -->
    <model name="human_target">
      <static>false</static>
      <pose>0.0 0.8 0.0 0 0 1.57079</pose>
      <link name="link">
        <gravity>false</gravity>

        <!-- Left Leg -->
        <collision name="left_leg_col">
          <pose>0.0 0.11 0.38 0 0 0</pose>
          <geometry><cylinder><radius>0.09</radius><length>0.75</length></cylinder></geometry>
        </collision>
        <visual name="left_leg_vis">
          <pose>0.0 0.11 0.38 0 0 0</pose>
          <geometry><cylinder><radius>0.09</radius><length>0.75</length></cylinder></geometry>
          <material><diffuse>0.20 0.22 0.28 1</diffuse></material>
        </visual>

        <!-- Right Leg -->
        <collision name="right_leg_col">
          <pose>0.0 -0.11 0.38 0 0 0</pose>
          <geometry><cylinder><radius>0.09</radius><length>0.75</length></cylinder></geometry>
        </collision>
        <visual name="right_leg_vis">
          <pose>0.0 -0.11 0.38 0 0 0</pose>
          <geometry><cylinder><radius>0.09</radius><length>0.75</length></cylinder></geometry>
          <material><diffuse>0.20 0.22 0.28 1</diffuse></material>
        </visual>

        <!-- Torso with Amber / Orange Clothing -->
        <collision name="torso_col">
          <pose>0.0 0.0 1.15 0 0 0</pose>
          <geometry><cylinder><radius>0.18</radius><length>0.80</length></cylinder></geometry>
        </collision>
        <visual name="torso_vis">
          <pose>0.0 0.0 1.15 0 0 0</pose>
          <geometry><cylinder><radius>0.18</radius><length>0.80</length></cylinder></geometry>
          <material><diffuse>0.85 0.55 0.15 1</diffuse></material>
        </visual>

        <!-- Head -->
        <visual name="head_vis">
          <pose>0.0 0.0 1.65 0 0 0</pose>
          <geometry><sphere><radius>0.12</radius></sphere></geometry>
          <material><diffuse>0.90 0.75 0.50 1</diffuse></material>
        </visual>

        <inertial>
          <mass>68.0</mass>
          <inertia>
            <ixx>10</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>10</iyy><iyz>0</iyz><izz>2</izz>
          </inertia>
        </inertial>
      </link>

      <plugin
        filename="gz-sim-velocity-control-system"
        name="gz::sim::systems::VelocityControl">
        <link_name>link</link_name>
        <topic>/human_target/cmd_vel</topic>
      </plugin>
    </model>

    <!-- Secondary Distractor Pedestrian (Cyan / Teal Torso) -->
    <model name="distractor_human">
      <static>false</static>
      <pose>-1.8 0.0 0.0 0 0 0.0</pose>
      <link name="link">
        <gravity>false</gravity>

        <!-- Left Leg -->
        <collision name="left_leg_col">
          <pose>0.0 0.11 0.38 0 0 0</pose>
          <geometry><cylinder><radius>0.09</radius><length>0.75</length></cylinder></geometry>
        </collision>
        <visual name="left_leg_vis">
          <pose>0.0 0.11 0.38 0 0 0</pose>
          <geometry><cylinder><radius>0.09</radius><length>0.75</length></cylinder></geometry>
          <material><diffuse>0.18 0.20 0.25 1</diffuse></material>
        </visual>

        <!-- Right Leg -->
        <collision name="right_leg_col">
          <pose>0.0 -0.11 0.38 0 0 0</pose>
          <geometry><cylinder><radius>0.09</radius><length>0.75</length></cylinder></geometry>
        </collision>
        <visual name="right_leg_vis">
          <pose>0.0 -0.11 0.38 0 0 0</pose>
          <geometry><cylinder><radius>0.09</radius><length>0.75</length></cylinder></geometry>
          <material><diffuse>0.18 0.20 0.25 1</diffuse></material>
        </visual>

        <!-- Torso with Distinct Cyan / Teal Clothing -->
        <collision name="torso_col">
          <pose>0.0 0.0 1.15 0 0 0</pose>
          <geometry><cylinder><radius>0.18</radius><length>0.80</length></cylinder></geometry>
        </collision>
        <visual name="torso_vis">
          <pose>0.0 0.0 1.15 0 0 0</pose>
          <geometry><cylinder><radius>0.18</radius><length>0.80</length></cylinder></geometry>
          <material><diffuse>0.15 0.70 0.85 1</diffuse></material>
        </visual>

        <!-- Head -->
        <visual name="head_vis">
          <pose>0.0 0.0 1.65 0 0 0</pose>
          <geometry><sphere><radius>0.12</radius></sphere></geometry>
          <material><diffuse>0.92 0.78 0.52 1</diffuse></material>
        </visual>

        <inertial>
          <mass>65.0</mass>
          <inertia>
            <ixx>10</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>10</iyy><iyz>0</iyz><izz>2</izz>
          </inertia>
        </inertial>
      </link>

      <plugin
        filename="gz-sim-velocity-control-system"
        name="gz::sim::systems::VelocityControl">
        <link_name>link</link_name>
        <topic>/distractor_human/cmd_vel</topic>
      </plugin>
    </model>

    <!-- Overhead Spectator Camera (Aerial Bird's-Eye Perspective) -->
    <model name="overhead_spectator_camera">
      <static>true</static>
      <pose>0.0 0.0 9.5 0 1.5707963 1.5707963</pose>
      <link name="link">
        <sensor name="overhead_cam" type="camera">
          <camera>
            <horizontal_fov>1.40</horizontal_fov>
            <image>
              <width>800</width>
              <height>800</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>20.0</far>
            </clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>15</update_rate>
          <visualize>false</visualize>
          <topic>/overhead_camera/image</topic>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
